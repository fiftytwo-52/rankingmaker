# Rankings Maker — Environment Variables
# Copy this file to .env and fill in your own values.
# NEVER commit .env to git (it is already gitignored).

# Optional: Vecteezy API credentials for stock art search
# Get yours at: https://www.vecteezy.com/api-docs/
VECTEEZY_API_KEY=your_vecteezy_api_key_here
VECTEEZY_ACCOUNT_ID=your_vecteezy_account_id_here
